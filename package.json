{
  "name": "kers-lab",
  "version": "0.1.0",
  "private": true,
  "description": "KERS Lab — Dall'induzione di Faraday all'MGU-K. Interactive electromagnetic-induction lab (Faraday-Neumann-Lenz to the F1 MGU-K).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "lint:commits": "commitlint --verbose"
  },
  "dependencies": {
    "katex": "0.16.47",
    "marked": "14.1.4",
    "three": "0.169.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/katex": "0.16.8",
    "@types/node": "22.20.5",
    "@types/three": "0.169.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "9.39.5",
    "eslint-config-prettier": "9.1.2",
    "globals": "15.15.0",
    "jsdom": "25.0.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
